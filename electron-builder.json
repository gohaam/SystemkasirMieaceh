{
  "appId": "com.mieacehpakismail.pos",
  "productName": "Mie Aceh Pak Ismail POS",
  "copyright": "Copyright © 2026 Mie Aceh Pak Ismail",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "src/db/schema.sql"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Mie Aceh Pak Ismail POS",
    "installerIcon": "public/favicon.ico",
    "uninstallerIcon": "public/favicon.ico"
  }
}
